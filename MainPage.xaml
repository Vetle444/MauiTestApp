<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.MainPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Test"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid Padding="24">
        <VerticalStackLayout Spacing="16"
                             VerticalOptions="Center">
            <Label Text="iOS modal NavigationPage navigation bar color repro"
                   FontSize="20"
                   HorizontalTextAlignment="Center" />

            <Button Text="Open modal: NavigationPage colors"
                    Clicked="OnOpenNavigationPageColorsModalClicked" />

            <Button Text="Open modal: page attached colors"
                    Clicked="OnOpenAttachedPropertyModalClicked" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
