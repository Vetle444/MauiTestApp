<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.SecondModalPage"
             Title="Second">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Test"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="16">
            <Label Text="This page should have a green navigation bar with black title and back text."
                   FontSize="18" />

            <Button Text="Push third page"
                    Clicked="OnPushThirdPageClicked" />

            <Button Text="Pop back"
                    Clicked="OnPopBackClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>