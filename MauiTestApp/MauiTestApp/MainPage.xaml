             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiTestApp="clr-namespace:MauiTestApp"
             xmlns:bugs="clr-namespace:MauiTestApp.Bugs"
             x:Class="MauiTestApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Button Text="Test"
                    Command="{mauiTestApp:Command ContentPageType={x:Type bugs:EditorScrollInCollectionView}}" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
