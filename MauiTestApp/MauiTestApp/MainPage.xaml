<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiTestApp="clr-namespace:MauiTestApp"
             xmlns:modalPageNotCleanedUp="clr-namespace:MauiTestApp.Bugs.ModalPageNotCleanedUp"
             x:Class="MauiTestApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button Text="ModalPageNotCleanedUp"
                    Command="{mauiTestApp:Command ContentPageType={x:Type modalPageNotCleanedUp:ModalPageNotCleanedUp}}" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
