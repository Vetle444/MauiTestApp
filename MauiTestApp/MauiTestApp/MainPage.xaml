<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.MainPage"
             Title="ToolbarItem Leak Repro">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Button Text="Push LeakPage (Navigation)"
                Clicked="OnPushLeakPage" />

        <Button Text="Push LeakPage (Modal)"
                Clicked="OnPushLeakPageModal" />

        <Button Text="Force GC &amp; Check"
                Clicked="OnForceGC" />

        <Label x:Name="StatusLabel" Text="" FontSize="14" TextColor="Red" />

    </VerticalStackLayout>

</ContentPage>
