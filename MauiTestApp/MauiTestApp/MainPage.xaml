<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Button Text="CollectionView Template Handler Test"
                    Clicked="OnCollectionViewTestClicked" />
            
            <Button Text="CollectionView Remove Items Test"
                    Clicked="OnCollectionViewRemoveTestClicked" />
            
            <Button Text="Show Labels With Connected Handlers"
                    Clicked="OnShowConnectedHandlers"
                    BackgroundColor="Orange" />
            
            <Button Text="Force Cleanup All Connected Handlers"
                    Clicked="OnForceCleanup"
                    BackgroundColor="Red" />
            
            <ScrollView MaximumHeightRequest="300">
                <Label x:Name="ConnectedHandlersLabel" 
                       Text="" 
                       FontSize="12" 
                       TextColor="Red"
                       Margin="0,5,0,0"/>
            </ScrollView>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
