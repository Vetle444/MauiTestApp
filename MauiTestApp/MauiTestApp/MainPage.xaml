<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.MainPage"
             Title="MainPage"
             HandlerChanging="OnPageHandlerChanging"
             HandlerChanged="OnPageHandlerChanged">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label x:Name="MyLabel"
               Text="I am a Label with x:Name"
               HandlerChanging="OnElementHandlerChanging"
               HandlerChanged="OnElementHandlerChanged" />

        <Entry x:Name="MyEntry"
               Placeholder="I am an Entry with x:Name"
               HandlerChanging="OnElementHandlerChanging"
               HandlerChanged="OnElementHandlerChanged" />

        <Button x:Name="SwapRootButton"
                Text="Clear Shell Items &amp; Swap Root"
                Clicked="OnSwapRootClicked"
                HandlerChanging="OnElementHandlerChanging"
                HandlerChanged="OnElementHandlerChanged" />

        <Button x:Name="ForceGcButton"
                Text="Force GC &amp; Log"
                Clicked="OnForceGcClicked"
                HandlerChanging="OnElementHandlerChanging"
                HandlerChanged="OnElementHandlerChanged" />

        <Label x:Name="StatusLabel"
               Text=""
               TextColor="Red"
               FontSize="14" />

    </VerticalStackLayout>

</ContentPage>
