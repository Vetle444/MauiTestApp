<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiTestApp"
             x:Class="MauiTestApp.CollectionViewTestPage"
             Title="CollectionView Template Test">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Template A (Active) - Uses HandlerTrackingLabel -->
            <DataTemplate x:Key="TemplateA">
                <VerticalStackLayout Padding="10" BackgroundColor="LightBlue">
                    <local:HandlerTrackingLabel Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Template A (Active)" FontSize="12" TextColor="Blue"/>
                </VerticalStackLayout>
            </DataTemplate>
            
            <!-- Template B (Inactive) - Uses regular Label -->
            <DataTemplate x:Key="TemplateB">
                <VerticalStackLayout Padding="10" BackgroundColor="LightGray">
                    <local:HandlerTrackingLabel Text="{Binding Name}" FontSize="18"/>
                    <Label Text="Template B (Inactive)" FontSize="12" TextColor="Gray"/>
                </VerticalStackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Items with mixed templates" FontSize="20" FontAttributes="Bold"/>
        
        <Button Text="Switch to all Template B (Remove active template)" 
                Clicked="OnSwitchToTemplateB"/>
        
        <Button Text="Switch back to mixed templates"
                Clicked="OnSwitchToMixed"/>
        
        <Button Text="Force GC and check handlers"
                Clicked="OnCheckHandlers"/>
        
        <Label x:Name="StatusLabel" Text="Status: Mixed templates active" 
               FontSize="14" Margin="0,10,0,0"/>
        
        <ScrollView MaximumHeightRequest="200">
            <Label x:Name="ConnectedHandlersLabel" 
                   Text="" 
                   FontSize="12" 
                   TextColor="Red"
                   Margin="0,5,0,0"/>
        </ScrollView>
        
        <CollectionView x:Name="ItemsCollectionView"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <local:ItemTemplateSelector x:Name="TemplateSelector"
                                           TemplateA="{StaticResource TemplateA}"
                                           TemplateB="{StaticResource TemplateB}"/>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    
</ContentPage>
