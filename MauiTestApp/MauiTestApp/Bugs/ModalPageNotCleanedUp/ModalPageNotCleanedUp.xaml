<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.Bugs.ModalPageNotCleanedUp.ModalPageNotCleanedUp"
             Title="Modal Page Cleanup Test">

    <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Modal Page Cleanup Test"
               FontSize="24"
               HorizontalOptions="Center" />

        <Button Text="Push Modal Page"
                Clicked="OnPushModal_Clicked" />

        <Button Text="Push Modal Page in NavigationPage"
                Clicked="OnPushModalInNavPage_Clicked" />

        <Button Text="Force GC &amp; Check Cleanup"
                Clicked="OnCheckCleanup_Clicked" />

        <Label x:Name="StatusLabel"
               FontSize="14"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
    </ScrollView>

</ContentPage>
