<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.SecondRootPage"
             Title="Second Root Page">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="10">

            <Label Text="Handler Log from MainPage:"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label x:Name="LogLabel"
                   Text=""
                   FontSize="12"
                   FontFamily="Courier" />

            <Button Text="Refresh"
                    Clicked="OnRefreshClicked" />

            <Button Text="Swap Back to MainPage"
                    Clicked="OnSwapBackClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
