<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiTestApp"
             x:Class="MauiTestApp.CollectionViewRemoveTestPage"
             Title="CollectionView Remove Items Test">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Single template with HandlerTrackingLabel -->
            <DataTemplate x:Key="ItemTemplate">
                <VerticalStackLayout Padding="10" BackgroundColor="LightBlue" Spacing="5">
                    <local:HandlerTrackingLabel Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Add/Remove Items Test" FontSize="20" FontAttributes="Bold"/>
        
        <Button Text="Add Item" 
                Clicked="OnAddItem"/>
        
        <Button Text="Remove First Item"
                Clicked="OnRemoveFirstItem"/>
        
        <Button Text="Clear All Items"
                Clicked="OnClearItems"/>
        
        <Button Text="Force GC and check handlers"
                Clicked="OnCheckHandlers"/>
        
        <Label x:Name="StatusLabel" Text="Status: Ready" 
               FontSize="14" Margin="0,10,0,0"/>
        
        <ScrollView MaximumHeightRequest="200">
            <Label x:Name="ConnectedHandlersLabel" 
                   Text="" 
                   FontSize="12" 
                   TextColor="Red"
                   Margin="0,5,0,0"/>
        </ScrollView>
        
        <CollectionView ItemsSource="{Binding Items}"
                        ItemTemplate="{StaticResource ItemTemplate}"
                        SelectionMode="None"/>
    </VerticalStackLayout>
    
</ContentPage>
