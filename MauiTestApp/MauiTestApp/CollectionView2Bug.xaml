<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestApp.CollectionView2Bug"
             x:Name="This">
    
    <CollectionView ItemsSource="{Binding Source={x:Reference This}, Path=Items}">
        
        <CollectionView.Header>
            <Button Text="Reverse"
                    Clicked="Button_OnClicked" />
        </CollectionView.Header>
        
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <VerticalStackLayout x:Name="VerticalStackLayout">
                    <Label Text="{Binding .}"
                           FontSize="30"/>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="Parent: "></Label>
                        <Label Text="{Binding Source={x:Reference VerticalStackLayout}, Path=Parent, TargetNullValue=`null`}"
                               Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        
    </CollectionView>
    
</ContentPage>